<!-- contact.wxml -->
<view class="container">
  <form bindsubmit="submitForm">
    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input type="text" name="name" placeholder="请输入姓名" class="form-input" value="{{formData.name}}" bindinput="onInput" data-field="name" />
    </view>

    <!-- 生日 -->
    <view class="form-item">
      <picker mode="date" value="{{date}}" start="1900-01-01"  end="{{currentDate}}" bindchange="onBirthdayChange">
    <view class="picker">
      生日: {{formData.birthday || '请选择'}}
    </view>
  </picker>
    </view>
    

    <!-- 意向项目 -->
    <view class="form-item">
      <text class="form-label">意向项目</text>
      <view class="checkbox-group">
        <label class="checkbox-item" wx:for="{{intendedPrograms}}" wx:key="value">
          <checkbox value="{{item.value}}" name="projects" bindchange="onProjectChange" checked="{{formData.projects.includes(item.value)}}" />
          <text>{{item.label}}</text>
        </label>
      </view>
      <!-- 其他项目输入框 -->
      <view wx:if="{{formData.projects.includes('其他')}}" class="form-item">
        <input type="text" name="otherProject" placeholder="请输入其他项目" class="form-input" value="{{formData.otherProject}}" bindinput="onInput" data-field="otherProject" />
      </view>
    </view>

    <!-- 最高学历 -->
    <view class="form-item">
      <text class="form-label">最高学历</text>
      <view class="radio-group">
        <label class="radio-item" wx:for="{{educationLevels}}" wx:key="value">
          <radio value="{{item.value}}" name="education" bindchange="onEducationChange" />
          <text>{{item.label}}</text>
        </label>
      </view>
    </view>

    <!-- 符合条件 -->
    <view class="form-item">
      <text class="form-label">请勾选复合条件的选项</text>
      <view class="checkbox-group">
        <label class="checkbox-item" wx:for="{{conditions}}" wx:key="value">
          <checkbox value="{{item.value}}" name="conditions" bindchange="onConditionChange" checked="{{formData.conditions.includes(item.value)}}" />
          <text>{{item.label}}</text>
        </label>
      </view>
    </view>

    <!-- 英语成绩 -->
    <view class="form-item">
      <text class="form-label">英语成绩</text>
      <view class="radio-group">
        <label class="radio-item" wx:for="{{englishLevels}}" wx:key="value">
          <radio value="{{item.value}}" name="englishLevel" bindchange="onEnglishLevelChange" />
          <text>{{item.label}}</text>
        </label>
      </view>
      <!-- 语言成绩输入框 -->
      <view wx:if="{{formData.englishLevel === '有语言成绩'}}" class="form-item">
        <input type="text" name="englishScore" placeholder="请输入语言成绩" class="form-input" value="{{formData.englishScore}}" bindinput="onInput" data-field="englishScore" />
      </view>
    </view>

    <!-- 育儿经验 -->
    <view class="form-item">
      <text class="form-label">是否有非亲属育儿经验</text>
      <view class="radio-group">
        <label class="radio-item" wx:for="{{childcareOptions}}" wx:key="value">
          <radio value="{{item.value}}" name="childcareExp" bindchange="onChildcareChange" />
          <text>{{item.label}}</text>
        </label>
      </view>
    </view>

    <!-- 所在城市 -->
    <view class="form-item">
      <text class="form-label">所在城市</text>
      <input type="text" name="city" placeholder="请输入所在城市" class="form-input" value="{{formData.city}}" bindinput="onInput" data-field="city" />
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <text class="form-label">联系方式（微信/手机号）</text>
      <input type="text" name="contact" placeholder="请输入微信或手机号" class="form-input" value="{{formData.contact}}" bindinput="onInput" data-field="contact" />
    </view>

    <!-- 提交按钮 -->
    <view class="form-submit">
      <button form-type="submit" class="submit-button" loading="{{loading}}">{{loading ? '提交中...' : '提交'}}</button>
    </view>
  </form>
</view>