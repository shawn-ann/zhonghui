/* contact.wxss */

.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

form {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  margin: 0 auto;
  width: 90%;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #ffffff;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #e81353;
  box-shadow: 0 0 0 2rpx rgba(30, 136, 229, 0.2);
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  background-color: #ffffff;
  transition: all 0.3s ease;
  box-sizing: border-box;
  overflow: hidden;
}

.form-picker-content {
  width: 100%;
  height: 100%;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #757575;
  line-height: 80rpx;
}

.form-picker:active .form-picker-content {
  background-color: #f5f5f5;
}

.form-picker-view {
  flex: 1;
}

.form-picker-arrow {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.3s ease;
}

.form-picker:active .form-picker-arrow {
  transform: scale(0.9);
}

.checkbox-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333333;
}

.checkbox-item checkbox {
  margin-right: 10rpx;
  transform: scale(1.2);
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333333;
}

.radio-item radio {
  margin-right: 10rpx;
  transform: scale(1.2);
}

.form-submit {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}

.submit-button {
  width: 100%;
  height: 80rpx;
  background-color: #e81353;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 0;
  border-radius: 8rpx;
  border: none;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.submit-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s;
}

.submit-button:hover::before {
  left: 100%;
}

.submit-button:hover {
  background-color: #c40f46;
  box-shadow: 0 4rpx 12rpx rgba(30, 136, 229, 0.4);
  transform: translateY(-2rpx);
}

.submit-button:active {
  transform: translateY(0);
}

.submit-button[loading] {
  background-color: #f8a0b9;
}

/* 自定义checkbox样式 */
checkbox .wx-checkbox-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e0e0e0;
  background: #ffffff;
  transition: all 0.3s;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background-color: #e81353;
  border-color: #e81353;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  text-align: center;
  font-size: 18rpx;
  color: #ffffff;
  background: transparent;
  transform: translate(-50%, -50%) scale(1);
  -webkit-transform: translate(-50%, -50%) scale(1);
}

/* 自定义radio样式 */
radio .wx-radio-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
  background: #ffffff;
  transition: all 0.3s;
}

radio .wx-radio-input.wx-radio-input-checked {
  border-color: #e81353;
  background: #ffffff;
}

radio .wx-radio-input.wx-radio-input-checked::before {
  width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  text-align: center;
  font-size: 18rpx;
  color: #e81353;
  background: #e81353;
  transform: translate(-50%, -50%) scale(1);
  -webkit-transform: translate(-50%, -50%) scale(1);
  border-radius: 50%;
}

/* 响应式设计 */
@media (min-width: 750rpx) {
  .container {
    padding: 40rpx;
  }
  
  form {
    padding: 40rpx;
  }
  
  .form-item {
    margin-bottom: 40rpx;
  }
  
  .form-submit {
    margin-top: 60rpx;
  }
}

/* 错误提示样式 */
.error-message {
  font-size: 24rpx;
  color: #F44336;
  margin-top: 8rpx;
  margin-left: 10rpx;
}
