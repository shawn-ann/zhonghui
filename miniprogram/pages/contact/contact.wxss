/* contact.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

form {
  background-color: #ffffff;
  border-radius: 10rpx;
  padding: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 15rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 5rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-picker {
  width: 100%;
  padding: 15rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 5rpx;
  font-size: 28rpx;
  color: #757575;
}

.checkbox-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.checkbox-item checkbox {
  margin-right: 10rpx;
  transform: scale(1.2);
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.radio-item radio {
  margin-right: 10rpx;
  transform: scale(1.2);
}

.form-submit {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.submit-button {
  width: 100%;
  background-color: #1E88E5;
  color: #ffffff;
  font-size: 32rpx;
  padding: 20rpx;
  border-radius: 10rpx;
}
