/* contact.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

form {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  margin: 0 auto;
  max-width: 600rpx;
  width: 90%;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #ffffff;
  transition: border-color 0.3s;
}

.form-input:focus {
  border-color: #1E88E5;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #757575;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  transition: border-color 0.3s;
}

.form-picker:focus {
  border-color: #1E88E5;
}

.checkbox-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333333;
}

.checkbox-item checkbox {
  margin-right: 10rpx;
  transform: scale(1.2);
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333333;
}

.radio-item radio {
  margin-right: 10rpx;
  transform: scale(1.2);
}

.form-submit {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
}

.submit-button {
  width: 100%;
  height: 80rpx;
  background-color: #1E88E5;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 0;
  border-radius: 8rpx;
  border: none;
  transition: background-color 0.3s;
}

.submit-button:hover {
  background-color: #1976D2;
}

.submit-button[loading] {
  background-color: #64B5F6;
}

/* 自定义checkbox样式 */
checkbox .wx-checkbox-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e0e0e0;
  background: #ffffff;
  transition: all 0.3s;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background-color: #1E88E5;
  border-color: #1E88E5;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  text-align: center;
  font-size: 18rpx;
  color: #ffffff;
  background: transparent;
  transform: translate(-50%, -50%) scale(1);
  -webkit-transform: translate(-50%, -50%) scale(1);
}

/* 自定义radio样式 */
radio .wx-radio-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
  background: #ffffff;
  transition: all 0.3s;
}

radio .wx-radio-input.wx-radio-input-checked {
  border-color: #1E88E5;
  background: #ffffff;
}

radio .wx-radio-input.wx-radio-input-checked::before {
  width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  text-align: center;
  font-size: 18rpx;
  color: #1E88E5;
  background: #1E88E5;
  transform: translate(-50%, -50%) scale(1);
  -webkit-transform: translate(-50%, -50%) scale(1);
  border-radius: 50%;
}

/* 响应式设计 */
@media (min-width: 750rpx) {
  .container {
    padding: 40rpx;
  }
  
  form {
    padding: 40rpx;
  }
  
  .form-item {
    margin-bottom: 40rpx;
  }
  
  .form-submit {
    margin-top: 60rpx;
  }
}

/* 错误提示样式 */
.error-message {
  font-size: 24rpx;
  color: #F44336;
  margin-top: 8rpx;
  margin-left: 10rpx;
}
