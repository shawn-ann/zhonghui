/* qa.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

/* 案例列表 */
.case-list {
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.case-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
  transition: background-color 0.2s;
}

.case-item:hover {
  background-color: #f9f9f9;
}

.case-item:last-child {
  border-bottom: none;
}

.case-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-right: 20rpx;
}

.case-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 10rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.case-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-date {
  font-size: 24rpx;
  color: #757575;
}

.case-view {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #757575;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}

.case-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  object-fit: cover;
}

/* 加载中提示 */
.loading-container {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-text {
  font-size: 28rpx;
  color: #757575;
}

/* 没有更多数据提示 */
.no-more-container {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.no-more-text {
  font-size: 28rpx;
  color: #757575;
}