/* detail.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.article-header {
  background-color: #ffffff;
  padding: 30rpx 20rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.article-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 15rpx;
  display: block;
}

.article-date {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.article-content {
  background-color: #ffffff;
  padding: 30rpx 20rpx;
}

.article-image {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

rich-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333333;
}

rich-text p {
  margin-bottom: 20rpx;
}

rich-text h2 {
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx 0;
  color: #333333;
}

.article-footer {
  margin-top: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.article-stats {
  display: flex;
  align-items: center;
}

.view-count {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}
