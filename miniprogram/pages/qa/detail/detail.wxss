/* detail.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.article-header {
  background-color: #ffffff;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 15rpx;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-date {
  font-size: 24rpx;
  color: #757575;
}

.article-view {
  font-size: 24rpx;
  color: #757575;
}

.article-content {
  background-color: #ffffff;
  padding: 20rpx;
}

.article-image {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

rich-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
}
