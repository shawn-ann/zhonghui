<!-- home.wxml -->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-container">
    <input type="text" placeholder="请输入关键词" class="search-input" />
  </view>

  <!-- 轮播图 -->
  <view class="carousel-container">
    <swiper indicator-dots="true" autoplay="true" interval="5000" duration="1000">
      <swiper-item wx:for="{{carouselImages}}" wx:key="id">
        <image src="{{item.image_url}}" class="carousel-image" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 子菜单 -->
  <view class="submenu-container">
    <view class="submenu-item" wx:for="{{submenus}}" wx:key="index">
      <image src="{{item.icon}}" class="submenu-icon" />
      <text class="submenu-text">{{item.title}}</text>
    </view>
  </view>

  <!-- 直播提示 -->
  <view class="live-container">
    <image src="/images/live-icon.png" class="live-icon" />
    <text class="live-text">直播：我的美国互惠生到小学老师蜕变记</text>
  </view>

  <!-- 案例分享列表 -->
  <view class="case-studies-container">
    <view class="section-title">案例分享</view>
    <view class="case-study-item" wx:for="{{caseStudies}}" wx:key="id" bindtap="navigateToCaseStudy" data-id="{{item.id}}">
      <image src="{{item.image_url}}" class="case-study-image" />
      <view class="case-study-content">
        <text class="case-study-title">{{item.title}}</text>
        <view class="case-study-meta">
          <text class="case-study-date">{{item.publish_date}}</text>
          <view class="case-study-stats">
            <text class="case-study-view">{{item.view_count}} 浏览</text>
            <text class="case-study-like">0 点赞</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>