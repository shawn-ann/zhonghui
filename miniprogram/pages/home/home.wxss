/* home.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 搜索框 */
.search-container {
  padding: 20rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
}

.search-input {
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 15rpx 20rpx;
  font-size: 28rpx;
  color: #757575;
  border: none;
  outline: none;
}

/* 轮播图 */
.carousel-container {
  margin: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background-color: #ffffff;
  padding: 20rpx;
}

.carousel-image {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
}

/* 子菜单 */
.submenu-container {
  display: flex;
  flex-wrap: wrap;
  background-color: #ffffff;
  padding: 20rpx;
  margin: 0 20rpx 20rpx 20rpx;
  border-radius: 10rpx;
}

.submenu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.submenu-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.submenu-text {
  font-size: 24rpx;
  color: #333333;
}


/* 案例分享列表 */
.case-studies-container {
  background-color: #ffffff;
  margin: 0 20rpx 20rpx 20rpx;
  border-radius: 10rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  border-left: 5rpx solid #e81353;
  padding-left: 15rpx;
}

.case-study-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.case-study-item:last-child {
  border-bottom: none;
}

.case-study-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.case-study-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.case-study-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.case-study-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-study-date {
  font-size: 24rpx;
  color: #757575;
}

.case-study-stats {
  display: flex;
  gap: 20rpx;
}

.case-study-view {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #757575;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}

/* 加载更多按钮 */
.load-more-container {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
}

.load-more-button {
  background-color: #f5f5f5;
  color: #e81353;
  border: 1rpx solid #e81353;
  border-radius: 20rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}

.load-more-button::after {
  border-radius: 20rpx;
}
