/* list.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}


/* 案例列表 */
.case-list {
  background-color: #ffffff;
  margin: 20rpx 0;
  border-radius: 10rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  border-left: 5rpx solid #e81353;
  padding-left: 15rpx;
}





/* 案例列表 */
.case-list {
  background-color: #ffffff;
  margin: 20rpx 0;
}

.case-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
  align-items: center;
}

.case-content {
  flex: 1;
  margin-right: 20rpx;
}

.case-title {
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 15rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.case-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.case-date {
  font-size: 26rpx;
  color: #999999;
}

.case-view {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
  margin-left: 20rpx;
}

.view-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}

.case-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
}

/* 加载中提示 */
.loading-container {
  padding: 30rpx;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* 没有更多数据提示 */
.no-more-container {
  padding: 30rpx;
  text-align: center;
}

.no-more-text {
  font-size: 26rpx;
  color: #999999;
}