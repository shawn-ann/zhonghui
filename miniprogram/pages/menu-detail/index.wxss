.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.loading-container {
  padding: 60rpx;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.menu-detail {
  padding: 20rpx;
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 10rpx;
}

.menu-content {
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.menu-content image {
  max-width: 100%;
  height: auto;
}